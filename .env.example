# Resend API key — required for the /api/contact route to deliver email.
# Create one at https://resend.com/api-keys
RESEND_API_KEY=

# The inbox that contact-form submissions are delivered to.
# Defaults to the address in app/lib/site.ts if unset.
CONTACT_EMAIL=

# The verified sender address (must be a domain verified in Resend).
# Defaults to Resend's onboarding sandbox sender if unset.
# Example: "Peter Nguyen <hello@yourdomain.com>"
CONTACT_FROM=
